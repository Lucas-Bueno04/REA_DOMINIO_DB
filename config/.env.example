# Copie para config/.env e preencha. Nunca versionar o .env.
DOM_DSN=Contabil
DOM_UID=
DOM_PWD=
# Driver ODBC (64 bits) caso queira conexão sem DSN
DOM_DRIVER=SQL Anywhere 17
DOM_OWNER=bethadba

# Limites do servidor MCP
MCP_MAX_ROWS=500
MCP_DEFAULT_ROWS=50
MCP_QUERY_TIMEOUT_S=60

# Transporte: stdio | http
MCP_TRANSPORT=stdio
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8765
MCP_AUTH_TOKEN=
